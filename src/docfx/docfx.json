{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "RetroCommander.Core/RetroCommander.Core.csproj",
            "RetroCommander.Desktop/RetroCommander.Desktop.csproj"
          ],
          "exclude": [ "**/*.Tests/**", "**/tests/**", "**/tools/**", "**/obj/**", "**/bin/**" ],
          "src": ".."
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "filter": "filterConfig.yml",
      "noRestore": false,
      "namespaceLayout": "nested",
      "memberLayout": "samePage",
      "allowCompilationErrors": false,
      "outputFormat": "mref"
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      { "files": [ "*.md", "toc.yml" ], "exclude": [ "README.md" ] },
      { "files": [ "docs/**.md", "docs/**/toc.yml" ] }
    ],
    "resource": [ { "files": [ "images/**" ] } ],
    "output": "_site",
    "globalMetadata": {
      "_appName": "RetroCommander",
      "_appTitle": "RetroCommander API reference",
      "_appFooter": "Copyright (c) 1985-2026 Ronny Hansen - MIT License - RetroCore Labs",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/RetroCoreLabs/RetroCommander",
        "branch": "main"
      }
    },
    "template": [ "default", "modern" ],
    "postProcessors": [ "ExtractSearchIndex" ],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
