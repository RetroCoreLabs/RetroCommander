<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RetroCommander.Desktop.PropertiesDialog"
        Title="Properties"
        Width="480" Height="560"
        MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FluentBackgroundPrimaryBrush}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Name="TitleText" Text="Properties" Classes="fluent-text-header" Margin="0,0,0,4"/>
            <TextBlock Name="NameText" Text="" Classes="fluent-text-secondary" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Body -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">

                <!-- Standard section -->
                <Border Classes="panel-border" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="General" Classes="fluent-text-header"/>
                        <Grid Name="StandardGrid" ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="12"/>
                    </StackPanel>
                </Border>

                <!-- Filesystem-specific details -->
                <Border Name="DetailsBorder" Classes="panel-border" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Name="DetailsHeaderText" Text="Filesystem Details" Classes="fluent-text-header"/>
                        <Grid Name="DetailsGrid" ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="12"/>
                    </StackPanel>
                </Border>

                <!-- NDFS file access (SINTRAN @SET-FILE-ACCESS file,public,friend,own). Shown only
                     for a file on a mounted NDFS volume. -->
                <Border Name="NdfsAccessBorder" Classes="panel-border" Padding="16" IsVisible="False">
                    <StackPanel Spacing="8">
                        <TextBlock Text="File Access" Classes="fluent-text-header"/>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Public, Friend, Own:" Classes="fluent-text-secondary"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Name="FileAccessSintranText" Classes="fluent-text"
                                       FontFamily="Consolas,Menlo,monospace"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Access Bits:" Classes="fluent-text-secondary"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Name="FileAccessBitsText" Classes="fluent-text"
                                       FontFamily="Consolas,Menlo,monospace"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="New value:" Classes="fluent-text-secondary"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBox Name="FileAccessBox" Width="170" FontFamily="Consolas,Menlo,monospace"
                                         Watermark="R,RWA,RWACD"/>
                                <Button Name="SetFileAccessButton" Content="Set" Click="OnSetFileAccessClick"
                                        Classes="dialog-secondary"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="fluent-text-secondary" TextWrapping="Wrap"
                                   Text="As SINTRAN's @SET-FILE-ACCESS: public,friend,own. Letters R W A C D, or N for none; an empty field keeps that part. The list above shows the access from when this dialog opened."/>
                        <TextBlock Name="FileAccessStatusText" Classes="fluent-text-secondary" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="12" Margin="0,16,0,0">
            <Button Content="Close" Classes="dialog-primary"
                    Click="OnCloseClick" IsDefault="True" IsCancel="True"/>
        </StackPanel>

    </Grid>
</Window>
