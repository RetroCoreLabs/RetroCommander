<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="RetroCommander.Desktop.EditFileDialog"
        Title="Edit File"
        Width="900" Height="700"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource FluentBackgroundPrimaryBrush}"
        FontFamily="{DynamicResource FluentFontFamily}"
        FontSize="{DynamicResource FluentFontSize}">

    <Window.Styles>
        <Style Selector="TextBlock.Info">
            <Setter Property="Foreground" Value="{DynamicResource FluentTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <!-- Keep the editor's surface consistent across all interaction states -->
        <Style Selector="TextBox.Editor">
            <Setter Property="Background" Value="{DynamicResource FluentBackgroundSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FluentTextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource FluentSelectionHighlightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.Editor:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource FluentBackgroundSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBox.Editor:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource FluentBackgroundSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBox.Editor:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource FluentBackgroundSecondaryBrush}"/>
        </Style>
    </Window.Styles>

    <Grid Background="{DynamicResource FluentBackgroundPrimaryBrush}" RowDefinitions="Auto,*,Auto">
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource FluentSurfaceAltBrush}" BorderBrush="{DynamicResource FluentBorderLightBrush}" BorderThickness="0,0,0,1" Padding="7">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Plain-text editor. Content is saved byte-for-byte (Latin-1); unsaved changes are discarded on Cancel."
                           Classes="Info"
                           VerticalAlignment="Center"/>
                <TextBlock Name="FileSizeText" Grid.Column="1" Classes="Info" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Content Area -->
        <TextBox Name="ContentEditor"
                 Grid.Row="1"
                 Classes="Editor"
                 IsReadOnly="False"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 Padding="8"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- Status Bar (accent-coloured; white text reads on the accent in every theme) -->
        <Border Grid.Row="2" Background="{DynamicResource FluentAccentBlueBrush}" Padding="8,4">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Name="FileNameText"
                           Grid.Column="0"
                           Foreground="White"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1"
                        Content="Save"
                        Click="OnSaveClick"
                        Classes="fluent-button"
                        Padding="12,4"
                        MinWidth="80"
                        Margin="0,0,10,0"/>
                <Button Grid.Column="2"
                        Content="Cancel"
                        Click="OnCancelClick"
                        Classes="fluent-button"
                        Padding="12,4"
                        MinWidth="80"/>
            </Grid>
        </Border>
    </Grid>
</Window>
