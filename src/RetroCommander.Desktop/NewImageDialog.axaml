<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="600"
        x:Class="RetroCommander.Desktop.NewImageDialog"
        Title="New Disk Image"
        Width="860" Height="600"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource FluentBackgroundPrimaryBrush}"
        FontFamily="{DynamicResource FluentFontFamily}"
        FontSize="{DynamicResource FluentFontSize}">

    <!-- Every list, option, check and text in this window comes from the RetroIO drivers
         (IBlankImageProvider metadata, read through BlankImageCatalogue). Nothing here names a
         format: a format RetroIO learns to create appears with no change to this file. -->

    <Window.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource FluentAccentBlueBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.Label">
            <Setter Property="Foreground" Value="{DynamicResource FluentTextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.GroupHeader">
            <Setter Property="Foreground" Value="{DynamicResource FluentTextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="6,0,0,6"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="230,*">

            <!-- 1. Machine -->
            <Border Grid.Column="0"
                    Background="{DynamicResource FluentBackgroundSecondaryBrush}"
                    BorderBrush="{DynamicResource FluentBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="8,12,8,12">
                    <TextBlock DockPanel.Dock="Top" Text="MACHINE" Classes="GroupHeader"/>
                    <ListBox Name="MachineList" SelectionMode="Single" Background="Transparent"
                             BorderThickness="0" SelectionChanged="OnMachineSelected"/>
                </DockPanel>
            </Border>

            <!-- No sideways scrolling: content is held to the window width so long text wraps. -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <!-- The spacing is a margin here, not Padding on the ScrollViewer: padding there is added on top of the viewport width, and the content then ran off the right edge. -->
                <StackPanel Spacing="10" Margin="18,14,18,14" Grid.IsSharedSizeScope="True">

                    <TextBlock Name="MachineTitle" Classes="SectionHeader"/>

                    <!-- 2. Disk (size and kind) -->
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Label"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Disk:" Classes="Label"/>
                        <ComboBox Grid.Column="1" Name="DiskCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnDiskSelected"/>
                    </Grid>

                    <!-- 3. The layout's own options, built from its BlankImageOption list -->
                    <!-- Labels come from the drivers and can be long, so the label column sizes to
                         the longest one (each label wraps past 260 px) instead of a fixed width. -->
                    <Grid Name="OptionsGrid" ColumnSpacing="10" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Label"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions></Grid>

                    <CheckBox Name="UnformattedCheck"
                              Content="Unformatted - all zeros, no file system (for a machine or emulator to format)"
                              IsCheckedChanged="OnInputChanged"/>

                    <!-- What the driver says about the disk -->
                    <Border BorderBrush="{DynamicResource FluentBorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12" Margin="0,6,0,0">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Details" Classes="GroupHeader" Margin="0,0,0,4"/>
                            <TextBlock Name="DetailsText" TextWrapping="Wrap"
                                       Foreground="{DynamicResource FluentTextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. File name -->
                    <Grid ColumnSpacing="10" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Label"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Output file:" Classes="Label"/>
                        <TextBox Grid.Column="1" Name="OutputPath" Watermark="Choose where to save..."
                                 TextChanged="OnInputChanged"/>
                        <Button Grid.Column="2" Content="Browse..." Click="OnBrowseClick"/>
                    </Grid>

                    <TextBlock Name="ValidationText" TextWrapping="Wrap" IsVisible="False"
                               Foreground="{DynamicResource FluentWarningBorderBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto">
                <CheckBox Grid.Column="0" Name="MountAfterCreate"
                          Content="Mount after create" IsChecked="True"
                          VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Name="CreateButton" Content="Create" Click="OnCreateClick"
                            Classes="dialog-primary" IsDefault="True"/>
                    <Button Content="Cancel" Click="OnCancelClick"
                            Classes="dialog-secondary" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
