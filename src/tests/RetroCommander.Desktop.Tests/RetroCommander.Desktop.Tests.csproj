<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RetroCommander.Desktop.Tests</AssemblyName>
    <RootNamespace>RetroCommander.Desktop.Tests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The UI project is a WinExe (Avalonia app); referencing it for view-model tests is fine. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Drives real Avalonia windows/controls (no real display needed) so dialog logic — combo
         selection, panel visibility toggles, live preview text — can be verified directly instead
         of only by manual click-through. -->
    <PackageReference Include="Avalonia.Headless.NUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RetroCommander.Desktop\RetroCommander.Desktop.csproj" />
  </ItemGroup>

</Project>
